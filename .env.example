# Copie para .env e preencha. Nunca versione o .env.

# Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-sonnet-5-5
MAX_ITERACOES=20

# Teams: token de segurança mostrado ao criar o webhook de saída
TEAMS_WEBHOOK_TOKEN=

# Power Automate: URL do gatilho "Quando uma solicitação de webhook do Teams for recebida"
POWER_AUTOMATE_URL=

# Postgres de integrações, usuário SOMENTE LEITURA (deploy/usuario_leitura.sql)
DB_DSN=postgresql://agente_leitura:TROQUE_A_SENHA@127.0.0.1:5432/NOME_DO_BANCO
DB_MAX_LINHAS=200

# Pipedrive: token de API do usuário dedicado do agente
PIPEDRIVE_TOKEN=
PIPEDRIVE_EMPRESA=suaempresa   # subdomínio: https://suaempresa.pipedrive.com
NOME_EMPRESA=Sua Empresa

# Quem pode aprovar correção de motivo de perda: nome exatamente como aparece no Teams, separados por vírgula
APROVADORES=Nome Sobrenome

ARQUIVO_ESTADO=/data/estado.sqlite3
